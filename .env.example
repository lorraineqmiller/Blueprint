# Copy this file to .env and fill in your own Supabase project's values to
# switch the app from local mock data to a real backend (auth + database).
# Leave .env absent/empty and the app runs exactly as the local demo, no
# other changes needed. See README "Connecting a real backend".
#
# For a Vercel (or any hosted) deployment, these same two values need to be
# added under the project's own Settings -> Environment Variables — a local
# .env file never reaches the build, since it's gitignored on purpose.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
